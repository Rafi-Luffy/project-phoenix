class TestEndToEndSimpleScenarios:
    """Simple end-to-end scenarios for basic functionality"""
    
    def test_e2e_simple_arithmetic_bug(self):
        """E2E: Detect and analyze simple arithmetic error"""
        # Create test project
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            # Write buggy code
            code_file = temp_dir / "math_ops.py"
            code_file.write_text("""
def add(a, b):
    return a - b  # Bug: should be +

def multiply(a, b):
    return a * b
""")
            
            # Write test
            test_file = temp_dir / "test_math.py"
            test_file.write_text("""
from math_ops import add, multiply

def test_add():
    assert add(2, 3) == 5

def test_multiply():
    assert multiply(2, 3) == 6
""")
            
            # Run Observer
            runner = TestRunner(temp_dir)
            result = runner.run_tests()
            
            assert result.total_tests >= 1
            assert result.failed >= 1
            
            # Detect failures
            detector = AgenticFailureDetector(project_id, temp_dir)
            failures = detector.detect_failures(result)
            
            assert len(failures) >= 1
            assert failures[0].failure_type == FailureType.TEST_FAILURE
            
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)
    
