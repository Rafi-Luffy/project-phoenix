        self.qubits = qubits
        self.state = [0] * (2 ** qubits)
        self.state[0] = 1  # |0...0> state
    
    def measure(self):
        # Simplified measurement
        total = sum(abs(x)**2 for x in self.state)
        if abs(total - 1.0) > 0.01:  # Bug: floating point comparison
            raise ValueError("Invalid quantum state")
        return random.choice(range(len(self.state)))
