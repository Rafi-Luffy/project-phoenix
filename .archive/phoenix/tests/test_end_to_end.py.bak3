import asyncio
from async_counter import Counter

def test_concurrent_increments():
    async def run_test():
        counter = Counter()
        await asyncio.gather(
            counter.increment(),
            counter.increment(),
            counter.increment()
        )
        assert counter.value == 3
    
    asyncio.run(run_test())
