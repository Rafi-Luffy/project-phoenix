        try:
            (temp_dir / "shared_resource.py").write_text("""
import threading

class SharedCounter:
    def __init__(self):
        self.count = 0
    
    def increment(self):
        temp = self.count
        # Simulate some work
        temp += 1
        self.count = temp  # Race condition
""")
            
            (temp_dir / "test_threading.py").write_text("""
from shared_resource import SharedCounter
import threading

def test_thread_safety():
    counter = SharedCounter()
    threads = []
    
    def increment_many():
        for _ in range(100):
            counter.increment()
    
    for _ in range(10):
        t = threading.Thread(target=increment_many)
        threads.append(t)
        t.start()
    
    for t in threads:
        t.join()
    
    assert counter.count == 1000
""")
            
            runner = TestRunner(temp_dir)
            result = runner.run_tests()
            
