    def test_e2e_concurrency_deadlock(self):
        """E2E: Deadlock detection"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "locks.py").write_text("""
import threading
import time

class ResourceManager:
    def __init__(self):
        self.lock_a = threading.Lock()
        self.lock_b = threading.Lock()
    
    def method_a(self):
        with self.lock_a:
            time.sleep(0.01)
            with self.lock_b:
                return "A"
    
    def method_b(self):
        with self.lock_b:
            time.sleep(0.01)
            with self.lock_a:  # Potential deadlock
                return "B"
""")
            
            (temp_dir / "test_deadlock.py").write_text("""
from locks import ResourceManager
import threading

def test_no_deadlock():
    manager = ResourceManager()
    results = []
    
    def call_a():
        results.append(manager.method_a())
    
    def call_b():
        results.append(manager.method_b())
    
    t1 = threading.Thread(target=call_a)
    t2 = threading.Thread(target=call_b)
    
    t1.start()
    t2.start()
    
    t1.join(timeout=2)
    t2.join(timeout=2)
    
    assert len(results) == 2
""")
            
            runner = TestRunner(temp_dir)
            result = runner.run_tests()
            
            # May timeout or fail due to deadlock
            assert result.total_tests >= 1
            
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)


