    def test_container_graceful_shutdown_sigterm(self):
        """Container: Graceful shutdown on SIGTERM"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "app_lifecycle.py").write_text("""
import signal
import time

class Application:
    def __init__(self):
        self.running = True
        self.active_requests = []
        self.shutdown_timeout = 30
    
    def handle_request(self, request_id):
        self.active_requests.append(request_id)
        time.sleep(0.1)
        self.active_requests.remove(request_id)
        return f"Processed {request_id}"
    
    def shutdown(self):
        # Bug: doesn't wait for active requests to complete
        self.running = False
        return True
    
    def graceful_shutdown(self, timeout=30):
        self.running = False
        start = time.time()
        
        while self.active_requests:
            if time.time() - start > timeout:
                # Force shutdown
                break
            time.sleep(0.1)
        
        return len(self.active_requests) == 0
""")
            
            (temp_dir / "test_lifecycle.py").write_text("""
from app_lifecycle import Application
import threading

def test_graceful_shutdown_waits_for_requests():
    app = Application()
    
    # Simulate active request
    def slow_request():
        app.handle_request("req-1")
    
    thread = threading.Thread(target=slow_request)
    thread.start()
    
    time.sleep(0.05)  # Let request start
    
    # Shutdown should wait
    result = app.graceful_shutdown(timeout=1)
    thread.join()
    
    assert result == True
    assert len(app.active_requests) == 0
