import os
from pathlib import Path

class VolumeManager:
    def __init__(self, mount_point="/data"):
        self.mount_point = Path(mount_point)
    
    def write_file(self, filename, content):
        filepath = self.mount_point / filename
        
        # Bug: doesn't check permissions before writing
        with open(filepath, 'w') as f:
            f.write(content)
        return True
    
    def check_writable(self):
        return os.access(self.mount_point, os.W_OK)
    
    def ensure_directory(self, dirname):
        dirpath = self.mount_point / dirname
        # Bug: doesn't handle permission errors
        dirpath.mkdir(parents=True, exist_ok=True)
        return True
