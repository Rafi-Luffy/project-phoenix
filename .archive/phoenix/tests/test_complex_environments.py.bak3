class AutoScaler:
    def __init__(self, min_instances=1, max_instances=10):
        self.min_instances = min_instances
        self.max_instances = max_instances
        self.current_instances = min_instances
    
    def should_scale_up(self, cpu_percent, memory_percent):
        # Bug: doesn't consider both metrics
        if cpu_percent > 80:
            return True
        return False
    
    def should_scale_down(self, cpu_percent, memory_percent):
        # Bug: can scale below minimum
        if cpu_percent < 20:
            return True
        return False
    
    def scale_up(self):
        if self.current_instances < self.max_instances:
            self.current_instances += 1
            return True
        return False
    
    def scale_down(self):
        # Bug: doesn't check minimum
        self.current_instances -= 1
        return True
""")
            
            (temp_dir / "test_autoscaling.py").write_text("""
from autoscaler import AutoScaler

def test_scale_considers_all_metrics():
    scaler = AutoScaler()
    
    # High CPU but low memory
    assert scaler.should_scale_up(cpu_percent=85, memory_percent=30) == True
    
    # Low CPU but high memory - should still scale up
    assert scaler.should_scale_up(cpu_percent=30, memory_percent=85) == True

def test_cannot_scale_below_minimum():
    scaler = AutoScaler(min_instances=2, max_instances=10)
    scaler.current_instances = 2
    
    # Should not scale below min
    result = scaler.scale_down()
    assert scaler.current_instances >= 2
