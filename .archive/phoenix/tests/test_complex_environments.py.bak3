            time.sleep(0.1)
        
        return f"Job {job_id} completed"
    
    def checkpoint_job(self, job_id, progress):
        self.checkpointed_jobs[job_id] = progress
    
    def resume_job(self, job_id):
        # Bug: doesn't check if checkpoint exists
        return self.checkpointed_jobs[job_id]
    
    def simulate_interruption(self):
        # Spot instance interrupted
        return "INTERRUPTED"
