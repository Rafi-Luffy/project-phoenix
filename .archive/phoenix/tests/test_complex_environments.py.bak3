class RaftNode:
    def __init__(self, node_id, cluster_size):
        self.node_id = node_id
        self.cluster_size = cluster_size
        self.current_term = 0
        self.voted_for = None
        self.is_leader = False
    
    def request_vote(self, term, candidate_id):
        if term > self.current_term:
            self.current_term = term
            self.voted_for = candidate_id
            return True
        return False
    
    def become_leader(self, votes_received):
        # Bug: doesn't check for majority
        if votes_received > 0:
            self.is_leader = True
            return True
        return False
    
    def check_quorum(self):
        # Bug: can have split-brain with 50% votes
        required_votes = self.cluster_size // 2
        return required_votes
""")
            
            (temp_dir / "test_consensus.py").write_text("""
from consensus import RaftNode

def test_leader_election_requires_majority():
    node = RaftNode(node_id=1, cluster_size=5)
    
    # With 2 votes out of 5, should NOT become leader
    result = node.become_leader(votes_received=2)
    assert result == False, "Should require majority (3/5) not just 2 votes"

def test_quorum_calculation():
    node = RaftNode(node_id=1, cluster_size=5)
    quorum = node.check_quorum()
    
    # Should require majority: ceil(5/2) + 1 = 3
    assert quorum >= 3, f"Quorum should be 3 for 5 nodes, got {quorum}"
