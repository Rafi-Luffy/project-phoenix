class SpotInstanceManager:
    def __init__(self):
        self.jobs = []
        self.checkpointed_jobs = {}
    
    def run_job(self, job_id, duration):
        # Simulate job execution
        start_time = time.time()
        
        # Bug: doesn't handle interruption
