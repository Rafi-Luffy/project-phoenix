from health_check import ApplicationHealthCheck
import time

def test_startup_probe_waits_for_initialization():
    health = ApplicationHealthCheck()
    
    # Immediately after creation, should NOT be ready
    assert health.startup_probe() == False or health.readiness_probe() == False

def test_readiness_probe_after_startup():
    health = ApplicationHealthCheck()
    
    # Should not be ready immediately
    assert health.readiness_probe() == False
    
    # After marking ready
    time.sleep(5.1)
    health.mark_ready()
    assert health.readiness_probe() == True
