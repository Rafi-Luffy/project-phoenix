    def test_distributed_message_queue_ordering(self):
        """Distributed: Message queue ordering guarantees"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "message_queue.py").write_text("""
from collections import deque
import threading

class DistributedQueue:
    def __init__(self):
        self.queue = deque()
        self.lock = threading.Lock()
    
    def publish(self, message, partition_key=None):
        # Bug: doesn't guarantee ordering for same partition
        self.queue.append(message)
    
    def consume(self):
        with self.lock:
            if self.queue:
                return self.queue.popleft()
        return None
    
    def consume_batch(self, batch_size):
        # Bug: no ordering guarantee in batch
        batch = []
        for _ in range(batch_size):
            msg = self.consume()
            if msg:
                batch.append(msg)
        return batch
""")
            
            (temp_dir / "test_message_queue.py").write_text("""
from message_queue import DistributedQueue

def test_fifo_ordering():
    queue = DistributedQueue()
    
    # Publish in order
    queue.publish({"id": 1, "data": "first"})
    queue.publish({"id": 2, "data": "second"})
    queue.publish({"id": 3, "data": "third"})
    
    # Should consume in FIFO order
    msg1 = queue.consume()
    msg2 = queue.consume()
    msg3 = queue.consume()
    
    assert msg1["id"] == 1
    assert msg2["id"] == 2
    assert msg3["id"] == 3

def test_partition_ordering():
    queue = DistributedQueue()
    
    # Messages with same partition key should maintain order
    queue.publish({"seq": 1}, partition_key="user-123")
    queue.publish({"seq": 2}, partition_key="user-123")
    queue.publish({"seq": 3}, partition_key="user-123")
    
    batch = queue.consume_batch(3)
    assert [msg["seq"] for msg in batch] == [1, 2, 3]
