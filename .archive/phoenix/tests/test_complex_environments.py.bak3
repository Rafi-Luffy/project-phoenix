class Pipeline:
    def __init__(self):
        self.stages = {}
        self.results = {}
    
    def add_stage(self, stage_name, dependencies=None):
        self.stages[stage_name] = {
            "dependencies": dependencies or [],
            "completed": False
        }
    
    def run_stage(self, stage_name):
        # Bug: doesn't check dependencies completed
        time.sleep(0.1)
        self.stages[stage_name]["completed"] = True
        self.results[stage_name] = "SUCCESS"
    
    def run_parallel(self):
        # Bug: runs all stages in parallel without dependency check
        threads = []
        for stage_name in self.stages:
            t = threading.Thread(target=self.run_stage, args=(stage_name,))
            threads.append(t)
            t.start()
        
        for t in threads:
            t.join()
