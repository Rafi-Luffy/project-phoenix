class TestCICDPipelineScenarios:
    """Test Phoenix in CI/CD pipeline environments"""
    
    def test_cicd_flaky_test_detection(self):
        """CI/CD: Flaky test detection and retries"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "test_runner.py").write_text("""
import random

class CICDTestRunner:
    def __init__(self):
        self.test_results = {}
        self.retry_count = 3
    
    def run_test(self, test_name):
        # Simulate flaky test
        result = random.choice([True, False])
        return result
    
