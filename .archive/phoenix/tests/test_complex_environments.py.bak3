import sys

class MemoryManager:
    def __init__(self, max_memory_mb=100):
        self.max_memory = max_memory_mb * 1024 * 1024  # bytes
        self.allocated = []
    
    def allocate(self, size_mb):
        size_bytes = size_mb * 1024 * 1024
        
        # Bug: doesn't check memory limit before allocation
        data = bytearray(size_bytes)
        self.allocated.append(data)
        return True
    
    def get_current_usage(self):
        return sum(len(data) for data in self.allocated)
    
    def can_allocate(self, size_mb):
        size_bytes = size_mb * 1024 * 1024
        return self.get_current_usage() + size_bytes <= self.max_memory
""")
            
