from deployment import DeploymentManager

def test_rollback_on_failed_health_check():
    manager = DeploymentManager()
    
    # Deploy v1 (healthy)
    manager.deploy("v1.0")
    
    # Deploy v2 (unhealthy)
    manager.deploy("v2.0")
    
    # Simulate failed health check
    if not manager.health_check():
        previous = manager.rollback()
        assert previous == "v1.0"
    
    # Current version should be v1.0
    assert manager.current_version == "v1.0"

