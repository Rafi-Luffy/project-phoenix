import time

class ReplicatedStore:
    def __init__(self):
        self.primary_data = {}
        self.replica_data = {}
        self.replication_lag = 0.1  # seconds
    
    def write(self, key, value):
        self.primary_data[key] = value
        # Async replication
        return True
    
    def read_from_primary(self, key):
        return self.primary_data.get(key)
    
    def read_from_replica(self, key):
        # Bug: doesn't wait for replication
        return self.replica_data.get(key)
    
    def sync_replicas(self):
        # Simulate replication
        time.sleep(self.replication_lag)
        self.replica_data = self.primary_data.copy()
""")
            
            (temp_dir / "test_replication.py").write_text("""
from replication import ReplicatedStore
import time

def test_read_after_write_consistency():
    store = ReplicatedStore()
    
    # Write to primary
    store.write("key1", "value1")
    
    # Immediate read from replica should handle lag
    result = store.read_from_replica("key1")
    
    # Should either return value or indicate not ready
    assert result is not None or result is None, "Should handle replication lag"

def test_eventual_consistency():
    store = ReplicatedStore()
    
    store.write("key2", "value2")
    
    # After sync, should be consistent
    store.sync_replicas()
    
    primary_val = store.read_from_primary("key2")
    replica_val = store.read_from_replica("key2")
    
    assert primary_val == replica_val == "value2"
