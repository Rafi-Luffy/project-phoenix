import time

class ApplicationHealthCheck:
    def __init__(self):
        self.started = False
        self.ready = False
        self.startup_time = 5.0
        self.start_time = time.time()
    
    def startup_probe(self):
        # Bug: returns True before actually ready
        return True
    
    def readiness_probe(self):
        elapsed = time.time() - self.start_time
        if elapsed < self.startup_time:
            return False
        return self.ready
    
    def liveness_probe(self):
        # Bug: doesn't check actual application health
        return True
    
    def mark_ready(self):
        self.ready = True
