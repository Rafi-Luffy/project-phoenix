from resource_manager import MemoryManager
import pytest

def test_memory_limit_enforcement():
    manager = MemoryManager(max_memory_mb=100)
    
    # Allocate within limit
    assert manager.allocate(50) == True
    
    # Try to exceed limit
    with pytest.raises(MemoryError):
        manager.allocate(60)  # Would exceed 100MB limit

def test_check_before_allocate():
    manager = MemoryManager(max_memory_mb=100)
    
    manager.allocate(80)
    
    # Should check capacity first
    can_allocate = manager.can_allocate(30)
    assert can_allocate == False
