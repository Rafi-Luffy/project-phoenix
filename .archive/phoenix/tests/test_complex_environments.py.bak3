class TestPhoenixInComplexEnvironments:
    """Test Phoenix's self-healing in complex production environments"""
    
    def test_phoenix_heals_distributed_system_bug(self):
        """Phoenix: Self-healing distributed consensus bug"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            # Create a complex distributed system with bug
            (temp_dir / "distributed_lock.py").write_text("""
import time
import threading

class DistributedLock:
    def __init__(self, lease_duration=10):
        self.lease_duration = lease_duration
        self.locks = {}
        self.lock = threading.Lock()
    
    def acquire(self, resource_id, client_id):
        with self.lock:
            if resource_id in self.locks:
                # Bug: doesn't check lease expiration
                return False
            
            self.locks[resource_id] = {
                "client_id": client_id,
                "acquired_at": time.time()
            }
            return True
    
    def release(self, resource_id, client_id):
        with self.lock:
            if resource_id in self.locks:
                if self.locks[resource_id]["client_id"] == client_id:
                    del self.locks[resource_id]
                    return True
        return False
    
    def is_locked(self, resource_id):
        return resource_id in self.locks
""")
            
            (temp_dir / "test_distributed_lock.py").write_text("""
from distributed_lock import DistributedLock
import time

def test_lock_lease_expiration():
    lock_manager = DistributedLock(lease_duration=1)
    
    # Client 1 acquires lock
    assert lock_manager.acquire("resource-1", "client-1") == True
    
    # Wait for lease to expire
    time.sleep(1.5)
    
    # Client 2 should be able to acquire expired lock
    assert lock_manager.acquire("resource-1", "client-2") == True

def test_lock_prevents_concurrent_access():
    lock_manager = DistributedLock()
    
    assert lock_manager.acquire("resource-2", "client-1") == True
    assert lock_manager.acquire("resource-2", "client-2") == False
    
    lock_manager.release("resource-2", "client-1")
    assert lock_manager.acquire("resource-2", "client-2") == True
