class TestChaosEngineeringScenarios:
    """Chaos engineering - inject failures and verify recovery"""
    
    def test_chaos_random_exceptions(self):
        """Chaos: Random exception injection"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "unreliable_service.py").write_text("""
import random

class UnreliableService:
    def __init__(self, failure_rate=0.3):
        self.failure_rate = failure_rate
        self.call_count = 0
    
    def call(self):
        self.call_count += 1
        if random.random() < self.failure_rate:
            raise Exception(f"Random failure on call {self.call_count}")
        return "success"
    
    def call_with_retry(self, max_retries=3):
        for attempt in range(max_retries):
            try:
                return self.call()
            except Exception as e:
                if attempt == max_retries - 1:
                    raise e
                continue  # Bug: no backoff
        return None
""")
            
            (temp_dir / "test_unreliable.py").write_text("""
from unreliable_service import UnreliableService

def test_service_with_retries():
    service = UnreliableService(failure_rate=0.5)
    
    # Should eventually succeed with retries
    successes = 0
    for _ in range(10):
        try:
            result = service.call_with_retry(max_retries=5)
            if result == "success":
                successes += 1
        except:
            pass
    
    assert successes > 0
""")
            
            runner = TestRunner(temp_dir)
            result = runner.run_tests()
            
            # Should handle randomness
            assert result.total_tests >= 1
            
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)
    
    def test_chaos_network_partition(self):
        """Chaos: Simulate network partitions"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "distributed_cache.py").write_text("""
import time

class DistributedCache:
    def __init__(self):
        self.local_cache = {}
        self.remote_cache = {}
        self.network_available = True
    
    def get(self, key):
        # Try local first
        if key in self.local_cache:
            return self.local_cache[key]
        
        # Try remote
        if self.network_available:
            if key in self.remote_cache:
                value = self.remote_cache[key]
                self.local_cache[key] = value  # Cache locally
                return value
        
        return None
    
    def set(self, key, value):
        self.local_cache[key] = value
        
        if self.network_available:
            self.remote_cache[key] = value
            return True
        
        # Bug: no queue for failed writes
        return False
    
    def simulate_network_partition(self):
        self.network_available = False
    
    def restore_network(self):
        self.network_available = True
""")
            
            (temp_dir / "test_distributed_cache.py").write_text("""
from distributed_cache import DistributedCache

def test_cache_during_partition():
    cache = DistributedCache()
    
    # Normal operation
    cache.set("key1", "value1")
    assert cache.get("key1") == "value1"
    
    # Simulate partition
    cache.simulate_network_partition()
    
    # Local cache should still work
    assert cache.get("key1") == "value1"
    
    # New writes should be queued (but they're not - bug)
    cache.set("key2", "value2")
    
    # Restore network
    cache.restore_network()
    
    # Should sync queued writes
    assert "key2" in cache.remote_cache
""")
            
            runner = TestRunner(temp_dir)
            result = runner.run_tests()
            
