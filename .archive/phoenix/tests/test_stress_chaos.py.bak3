            if len(failures) > 0:
                assert failures[0].failure_type == FailureType.TEST_FAILURE
            
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)
    
    def test_chaos_resource_exhaustion(self):
        """Chaos: Resource exhaustion scenarios"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "resource_manager.py").write_text("""
class ResourcePool:
    def __init__(self, max_resources=10):
        self.max_resources = max_resources
        self.available = max_resources
        self.in_use = 0
    
    def acquire(self, timeout=5):
        import time
        start = time.time()
        
        while self.available <= 0:
            if time.time() - start > timeout:
                raise TimeoutError("Resource pool exhausted")
            time.sleep(0.1)
        
        self.available -= 1
        self.in_use += 1
        return True
    
    def release(self):
        if self.in_use > 0:
            self.in_use -= 1
            self.available += 1
        # Bug: no error if releasing when nothing in use
""")
            
            (temp_dir / "test_resources.py").write_text("""
from resource_manager import ResourcePool
import threading
import time

def test_resource_pool_exhaustion():
    pool = ResourcePool(max_resources=5)
    
    def worker():
        pool.acquire()
        time.sleep(0.5)
        pool.release()
    
    threads = []
    for _ in range(10):
        t = threading.Thread(target=worker)
        threads.append(t)
        t.start()
    
    for t in threads:
        t.join(timeout=3)
    
    # All resources should be back
    assert pool.available == 5
""")
            
            runner = TestRunner(temp_dir)
            result = runner.run_tests()
            
            # Should handle resource contention
            assert result.total_tests >= 1
            
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)
    
