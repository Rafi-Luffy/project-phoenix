class TestComplexStateManagement:
    """Complex state transitions and management"""
    
    def test_complex_state_machine(self):
        """Complex: State machine with many transitions"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "state_machine.py").write_text("""
class OrderStateMachine:
    STATES = ["CREATED", "PAID", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"]
    
    TRANSITIONS = {
        "CREATED": ["PAID", "CANCELLED"],
        "PAID": ["PROCESSING", "CANCELLED"],
        "PROCESSING": ["SHIPPED", "CANCELLED"],
        "SHIPPED": ["DELIVERED"],
        "DELIVERED": [],
        "CANCELLED": []
    }
    
    def __init__(self):
        self.state = "CREATED"
        self.history = [self.state]
    
    def transition(self, new_state):
        if new_state not in self.TRANSITIONS.get(self.state, []):
            raise ValueError(f"Invalid transition from {self.state} to {new_state}")
        
        self.state = new_state
        self.history.append(new_state)
    
    def can_transition_to(self, state):
        return state in self.TRANSITIONS.get(self.state, [])
    
    def cancel(self):
        # Bug: doesn't check if cancellation is allowed
        self.state = "CANCELLED"
        self.history.append("CANCELLED")
""")
            
            (temp_dir / "test_state_machine.py").write_text("""
from state_machine import OrderStateMachine
import pytest

def test_valid_transitions():
    order = OrderStateMachine()
    
    order.transition("PAID")
    assert order.state == "PAID"
    
    order.transition("PROCESSING")
    assert order.state == "PROCESSING"

def test_invalid_transition():
    order = OrderStateMachine()
    
    with pytest.raises(ValueError):
        order.transition("DELIVERED")  # Can't go directly to DELIVERED

def test_cancel_after_delivery():
    order = OrderStateMachine()
    order.transition("PAID")
    order.transition("PROCESSING")
    order.transition("SHIPPED")
    order.transition("DELIVERED")
    
    # Bug: should not allow cancellation after delivery
    order.cancel()
    assert order.state != "CANCELLED"  # This will fail
""")
            
            runner = TestRunner(temp_dir)
            result = runner.run_tests()
            
            # Will fail on cancel after delivery
            detector = AgenticFailureDetector(project_id, temp_dir)
            failures = detector.detect_failures(result)
            
            if len(failures) > 0:
                assert failures[0].failure_type == FailureType.TEST_FAILURE
            
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)
    
    def test_complex_transaction_rollback(self):
        """Complex: Transaction rollback with nested operations"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "transaction.py").write_text("""
class Transaction:
    def __init__(self):
        self.operations = []
        self.committed = False
        self.rolled_back = False
    
    def add_operation(self, operation):
        if self.committed or self.rolled_back:
            raise Exception("Transaction already finalized")
        self.operations.append(operation)
    
    def commit(self):
        if self.rolled_back:
            raise Exception("Cannot commit rolled back transaction")
        
        for op in self.operations:
            op.execute()
        
        self.committed = True
    
    def rollback(self):
        if self.committed:
            raise Exception("Cannot rollback committed transaction")
        
        # Bug: doesn't execute rollback operations in reverse
        for op in self.operations:
            if hasattr(op, 'undo'):
                op.undo()
        
        self.rolled_back = True

class Operation:
    def __init__(self, name, execute_fn, undo_fn=None):
        self.name = name
        self.execute_fn = execute_fn
        self.undo_fn = undo_fn
        self.executed = False
    
    def execute(self):
        self.execute_fn()
        self.executed = True
    
    def undo(self):
        if self.undo_fn and self.executed:
            self.undo_fn()
            self.executed = False
""")
            
            (temp_dir / "test_transaction.py").write_text("""
from transaction import Transaction, Operation

def test_transaction_commit():
    state = {"value": 0}
    
    txn = Transaction()
    txn.add_operation(Operation("inc", lambda: state.update({"value": state["value"] + 1})))
    txn.add_operation(Operation("inc", lambda: state.update({"value": state["value"] + 1})))
    
    txn.commit()
    assert state["value"] == 2

def test_transaction_rollback():
    state = {"value": 0}
    
    txn = Transaction()
    txn.add_operation(Operation(
        "inc",
        lambda: state.update({"value": state["value"] + 1}),
        lambda: state.update({"value": state["value"] - 1})
    ))
    
    # Execute to change state
    for op in txn.operations:
        op.execute()
    
    assert state["value"] == 1
    
    # Rollback
    txn.rollback()
    assert state["value"] == 0
""")
            
            runner = TestRunner(temp_dir)
            result = runner.run_tests()
            
            # Should handle transactions
            assert result.total_tests >= 2
            
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)


class TestRealisticProductionScenarios:
    """Production-like scenarios"""
    
    def test_production_rate_limiting(self):
        """Production: Rate limiting implementation"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "rate_limiter.py").write_text("""
import time
from collections import deque

class RateLimiter:
    def __init__(self, max_requests, time_window):
        self.max_requests = max_requests
        self.time_window = time_window
        self.requests = deque()
    
    def allow_request(self):
        now = time.time()
        
        # Remove old requests
        while self.requests and self.requests[0] < now - self.time_window:
            self.requests.popleft()
        
        # Bug: doesn't check limit correctly
        if len(self.requests) < self.max_requests:
            self.requests.append(now)
            return True
        
        return False
    
    def get_remaining_requests(self):
        now = time.time()
        while self.requests and self.requests[0] < now - self.time_window:
            self.requests.popleft()
        
        return max(0, self.max_requests - len(self.requests))
""")
            
            (temp_dir / "test_rate_limiter.py").write_text("""
from rate_limiter import RateLimiter
import time

def test_rate_limiting():
    limiter = RateLimiter(max_requests=5, time_window=1.0)
    
    # Should allow first 5 requests
    for i in range(5):
        assert limiter.allow_request() == True
    
    # Should deny 6th request
    assert limiter.allow_request() == False
    
    # After time window, should allow again
    time.sleep(1.1)
    assert limiter.allow_request() == True
""")
            
            runner = TestRunner(temp_dir)
            result = runner.run_tests()
            
            # Should implement rate limiting correctly
            assert result.total_tests >= 1
            
        finally:
