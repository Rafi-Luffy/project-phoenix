    def test_production_feature_flags(self):
        """Production: Feature flag system"""
        temp_dir = Path(tempfile.mkdtemp())
        project_id = uuid4()
        
        try:
            (temp_dir / "feature_flags.py").write_text("""
class FeatureFlags:
    def __init__(self):
        self.flags = {}
        self.user_overrides = {}
    
    def set_flag(self, flag_name, enabled, percentage=100):
        self.flags[flag_name] = {
            "enabled": enabled,
            "percentage": percentage
        }
    
    def is_enabled(self, flag_name, user_id=None):
        if flag_name not in self.flags:
            return False
        
        # Check user override
