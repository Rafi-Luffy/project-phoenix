# Phoenix Configuration

# Database
DATABASE_URL=postgresql://phoenix:phoenix@localhost:5432/phoenix
VECTOR_STORE_PATH=./data/vector_store

# LLM Providers (configure at least one)
OPENAI_API_KEY=your-openai-key
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key

# LLM Configuration
DEFAULT_LLM_PROVIDER=openai  # openai, gemini, or anthropic
DEFAULT_MODEL=gpt-4-turbo-preview
CRITIC_MODEL=gpt-4-turbo-preview
PROGRAMMER_MODEL=gpt-4-turbo-preview

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Phoenix Runtime
MAX_ATTEMPTS=5
VALIDATION_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Docker
DOCKER_REGISTRY=phoenix
SANDBOX_BASE_IMAGE=python:3.11-slim

# Metrics
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
