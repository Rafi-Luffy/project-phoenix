# System Configuration
SYSTEM_NAME=Autonomous Self-Healing System
SYSTEM_VERSION=0.1.0
DEBUG=False

# Database
DATABASE_URL=postgresql://autonomous_user:secure_password@localhost:5432/autonomous_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

# Authentication
SECRET_KEY=change-this-to-a-secure-random-key-in-production
TOKEN_EXPIRATION_HOURS=24
JWT_ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=logs/system.log

# Monitoring
METRICS_ENABLED=True
PROMETHEUS_PORT=9090

# Agent System
MAX_AGENTS=1000
AGENT_TIMEOUT_SECONDS=300
AGENT_RETRY_ATTEMPTS=3

# Memory
SHORT_TERM_MEMORY_SIZE=1000
LONG_TERM_MEMORY_RETENTION_DAYS=30
MEMORY_CLEANUP_INTERVAL_HOURS=24

# Message Bus
MESSAGE_QUEUE_MAX_SIZE=50000
MESSAGE_HISTORY_RETENTION=50000

# Performance
PERFORMANCE_MONITORING_ENABLED=True
PERFORMANCE_METRICS_INTERVAL_SECONDS=60

# Caching
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=False
CACHE_TTL_SECONDS=3600

# API
API_TITLE=Autonomous Self-Healing System API
API_VERSION=0.1.0
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# Security
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# Error Handling
MAX_FAILED_LOGIN_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_MINUTES=15


#open router credentials
openrouter_api_key=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